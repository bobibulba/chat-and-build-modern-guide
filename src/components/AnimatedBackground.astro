<div class="animated-background">
  <div class="gradient-sphere sphere-1"></div>
  <div class="gradient-sphere sphere-2"></div>
  <div class="gradient-sphere sphere-3"></div>
  <div class="grid-overlay"></div>
</div>

<style>
  .animated-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
  }
  
  .gradient-sphere {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.15;
  }
  
  .sphere-1 {
    background: radial-gradient(circle, rgba(var(--primary), 1) 0%, rgba(var(--primary), 0) 70%);
    width: 50vw;
    height: 50vw;
    top: -10%;
    left: -10%;
    animation: float-slow 15s ease-in-out infinite alternate;
  }
  
  .sphere-2 {
    background: radial-gradient(circle, rgba(var(--secondary), 1) 0%, rgba(var(--secondary), 0) 70%);
    width: 40vw;
    height: 40vw;
    bottom: -10%;
    right: -10%;
    animation: float-slow 20s ease-in-out infinite alternate-reverse;
  }
  
  .sphere-3 {
    background: radial-gradient(circle, rgba(var(--accent), 1) 0%, rgba(var(--accent), 0) 70%);
    width: 30vw;
    height: 30vw;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: pulse-slow 15s ease-in-out infinite;
  }
  
  .grid-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      linear-gradient(to right, rgba(var(--border), 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(var(--border), 0.05) 1px, transparent 1px);
    background-size: 50px 50px;
  }
  
  @keyframes float-slow {
    0% {
      transform: translate(0, 0);
    }
    100% {
      transform: translate(5%, 5%);
    }
  }
  
  @keyframes pulse-slow {
    0%, 100% {
      opacity: 0.15;
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      opacity: 0.2;
      transform: translate(-50%, -50%) scale(1.1);
    }
  }
</style>
