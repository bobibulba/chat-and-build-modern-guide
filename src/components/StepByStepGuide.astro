---
interface Step {
  number: number;
  title: string;
  description: string;
  image: string;
  tips: string[];
}

const steps: Step[] = [
  {
    number: 1,
    title: "Define Your Project",
    description: "Start by clearly defining what you want to build. Be specific about the features, functionality, and purpose of your application.",
    image: "/images/define.svg",
    tips: [
      "Think about the problem your app solves",
      "List the core features you need",
      "Consider your target users"
    ]
  },
  {
    number: 2,
    title: "Start a New Project",
    description: "Open ChatAndBuild and click on 'New Project'. Give your project a name and select a template if applicable.",
    image: "/images/start.svg",
    tips: [
      "Choose a descriptive project name",
      "Templates can save time for common app types",
      "You can always start from scratch"
    ]
  },
  {
    number: 3,
    title: "Describe Your App",
    description: "Tell ChatAndBuild what you want to build using natural language. Be as detailed as possible about the functionality and design.",
    image: "/images/describe.svg",
    tips: [
      "Include specific features you want",
      "Mention design preferences",
      "Describe user interactions"
    ]
  },
  {
    number: 4,
    title: "Review & Refine",
    description: "ChatAndBuild will generate your app. Review the code and preview, then refine by asking for specific changes or additions.",
    image: "/images/review.svg",
    tips: [
      "Test all features in the preview",
      "Ask for explanations if needed",
      "Request specific modifications"
    ]
  },
  {
    number: 5,
    title: "Deploy Your App",
    description: "Once you're satisfied with your app, deploy it with a single click. ChatAndBuild supports various hosting platforms.",
    image: "/images/deploy.svg",
    tips: [
      "Choose the right hosting for your needs",
      "Set up a custom domain if needed",
      "Configure environment variables"
    ]
  }
];
---

<div class="steps-container">
  {steps.map((step) => (
    <div class="step">
      <div class="step-number">{step.number}</div>
      <div class="step-content">
        <div class="step-header">
          <h3>{step.title}</h3>
        </div>
        <div class="step-body">
          <div class="step-image">
            <img src={step.image} alt={step.title} />
          </div>
          <div class="step-info">
            <p>{step.description}</p>
            <div class="step-tips">
              <h4>Tips:</h4>
              <ul>
                {step.tips.map((tip) => (
                  <li>{tip}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  ))}
</div>

<style>
  .steps-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin: 3rem 0;
  }
  
  .step {
    display: flex;
    gap: 1.5rem;
  }
  
  .step-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    background: rgb(var(--primary));
    color: white;
    border-radius: 50%;
    font-weight: 700;
    font-size: 1.5rem;
    flex-shrink: 0;
  }
  
  .step-content {
    flex: 1;
    background: rgb(var(--card));
    border-radius: 1rem;
    border: 1px solid rgb(var(--border));
    overflow: hidden;
  }
  
  .step-header {
    padding: 1.25rem;
    border-bottom: 1px solid rgb(var(--border));
  }
  
  .step-header h3 {
    margin: 0;
    font-size: 1.25rem;
  }
  
  .step-body {
    padding: 1.25rem;
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  
  .step-image {
    flex: 1;
    min-width: 200px;
    max-width: 300px;
  }
  
  .step-image img {
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }
  
  .step-info {
    flex: 2;
    min-width: 300px;
  }
  
  .step-info p {
    margin-bottom: 1.25rem;
  }
  
  .step-tips {
    background: rgba(var(--primary), 0.05);
    border-radius: 0.5rem;
    padding: 1rem;
  }
  
  .step-tips h4 {
    margin-top: 0;
    margin-bottom: 0.5rem;
    font-size: 1rem;
    color: rgb(var(--primary));
  }
  
  .step-tips ul {
    margin: 0;
    padding-left: 1.5rem;
  }
  
  .step-tips li {
    margin-bottom: 0.5rem;
  }
  
  .step-tips li:last-child {
    margin-bottom: 0;
  }
  
  @media (max-width: 768px) {
    .step {
      flex-direction: column;
      gap: 1rem;
    }
    
    .step-number {
      margin-left: 1rem;
    }
    
    .step-body {
      flex-direction: column;
    }
    
    .step-image {
      max-width: 100%;
    }
  }
</style>
